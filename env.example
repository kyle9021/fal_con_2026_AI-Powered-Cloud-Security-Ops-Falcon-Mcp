# ---------------------------------------------------------------------------
# Falcon MCP harness -- credential and configuration template
#
#   cp env.example .env
#   chmod 600 .env
#   ./scripts/doctor.sh
#
# Note the filename: this template is "env.example", without a leading dot,
# so that the harness can keep a blanket "never read .env*" rule in
# .claude/settings.json. Anything matching .env* is treated as a live secret.
#
# .env is gitignored. Never commit it, never paste it into a chat window, and
# never put real credentials in this template.
# ---------------------------------------------------------------------------

# --- Required: Falcon API credentials --------------------------------------
# Create these in the Falcon console: Support and resources > API clients and keys.
# Grant the READ scopes listed in docs/api-scopes.md and nothing more.
FALCON_CLIENT_ID=your-client-id
FALCON_CLIENT_SECRET=your-client-secret

# --- Required: your tenant's region ----------------------------------------
# Getting this wrong produces a 403 at authentication that looks exactly like
# bad credentials. If doctor.sh reports 403, check this line first.
#
#   US-1       https://api.crowdstrike.com
#   US-2       https://api.us-2.crowdstrike.com
#   US-3       https://api.us-3.crowdstrike.com
#   EU-1       https://api.eu-1.crowdstrike.com
#   US-GOV-1   https://api.laggar.gcw.crowdstrike.com
#   US-GOV-2   https://api.us-gov-2.crowdstrike.mil
FALCON_BASE_URL=https://api.crowdstrike.com

# --- Security posture: read-only by default --------------------------------
# The single most important line in this file.
#
# With this true, the MCP server registers only read-only tools -- the write
# tools are not merely discouraged, they are never exposed to the model at all.
# The PreToolUse hook is a second, independent layer on top of this.
#
# Leave this true for at least your first two weeks. See docs/security.md
# before you consider changing it.
FALCON_MCP_READ_ONLY=true

# --- Security posture: least-privilege tool surface ------------------------
# falcon-mcp 0.17.0 ships 27 modules and 139 tools (94 read, 45 write). Loading
# all of them gives the model a large surface it does not need and floods its
# context with tool definitions, which measurably degrades tool selection.
#
# Enable only the modules your workflows actually use. The set below covers
# both workshop demos and the posture brief.
#
# NOTE: an unknown module name is a hard startup failure, not a warning -- the
# server refuses to launch and you get no Falcon tools at all. Valid names for
# 0.17.0: agentworks, cases, cloud, correlationrules, customioa, dataprotection,
# detections, discover, exclusions, firewall, fusion, hostgroups, hosts, idp,
# intel, ioc, ngsiem, policies, quarantine, recon, rtr, scheduledreports,
# sensorusage, serverless, shield, spotlight, zerotrustassessment.
# There is no "incidents" module -- it was removed upstream.
FALCON_MCP_MODULES=detections,hosts,spotlight,cloud,intel,discover

# Optional belt-and-braces: an explicit denylist, applied even in read-only
# mode. Uncomment to harden further. Unknown tool names also abort startup,
# so keep these exact -- note add_ioc is singular, remove_iocs is plural.
#FALCON_MCP_EXCLUDE_TOOLS=falcon_add_ioc,falcon_remove_iocs

# --- Optional: harness behaviour -------------------------------------------
# Keep credentials outside the repo entirely by pointing at another file:
#HARNESS_ENV_FILE=/etc/falcon-harness/credentials

# Unlock write tools. Deliberately left commented out -- read docs/security.md
# first. Destructive tools stay blocked regardless of this setting.
#HARNESS_ALLOW_WRITES=true

# Posture brief tuning.
#HARNESS_BRIEF_DISABLE=false          # true turns the SessionStart brief off
#HARNESS_BRIEF_BUDGET=12              # wall-clock seconds before it gives up.
                                      # Raise to 14 on conference/hotel wifi.
                                      # Past 14, also raise the SessionStart
                                      # hook timeout in .claude/settings.json.
#HARNESS_STALE_HOST_DAYS=14           # "stale host" threshold
#HARNESS_DETECTION_WINDOW_HOURS=24    # detection lookback window

# Ceiling on records per Falcon MCP call, enforced by the PreToolUse hook -- it
# rewrites a larger `limit` down to this and tells the model the count is a floor.
# 25 is what docs/context-discipline.md asks for; the hook is what makes it true.
# Set 0 to disable clamping. Prefer `/crystallize` over raising this: bulk
# pagination belongs in a script with no model attached.
#HARNESS_MAX_LIMIT=25

# --- Optional: MSSP / Flight Control ---------------------------------------
# Target a specific child CID when authenticating with parent credentials.
#FALCON_MEMBER_CID=

# --- Optional: egress proxy ------------------------------------------------
#FALCON_PROXY_URL=http://proxy.internal:3128
